DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# External chat-agent service (Cloud Run) used by per-agent chat completions.
# Paperclip POSTs to this URL with { model, systemPrompt, history, message,
# params, metadata } and expects { content, model?, finishReason?, tokenUsage? }
# back. The service is responsible for talking to Gemini (or any other LLM).
# Override per-company by creating company secrets named
# CHAT_AGENT_SERVICE_URL and CHAT_AGENT_SERVICE_TOKEN; these env vars are the
# instance-wide fallback.
CHAT_AGENT_SERVICE_URL=https://gemini-chat-agent-56688938888.us-east1.run.app/chat
# CHAT_AGENT_SERVICE_TOKEN=
