# ==============================================================================
# Plantilla de Variables de Entorno para Paperclip en GCP (Modo Authenticated)
# Servidor: paperclip (:3100)
# ==============================================================================

# Entorno y Puertos
NODE_ENV=production
PORT=3100
HOST=127.0.0.1

# Base de Datos PostgreSQL (Cloud SQL via Cloud SQL Proxy)
DATABASE_URL=postgresql://paperclip:<DB_PASSWORD>@127.0.0.1:5432/paperclip

# Modo de Despliegue y Exposición
# NOTA: el Dockerfile trae PAPERCLIP_DEPLOYMENT_EXPOSURE=private por defecto —
# hay que pasar 'public' explícito si el dominio es accesible desde internet.
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=public

# URLs Públicas y Configuración Estricta de Better Auth
# NOTA CRÍTICA: En modo authenticated y public exposure, PAPERCLIP_AUTH_BASE_URL_MODE
# DEBE ser 'explicit' y PAPERCLIP_AUTH_PUBLIC_BASE_URL debe coincidir con el dominio público.
# Sin esto el contenedor entra en crash loop con:
# "authenticated public exposure requires auth.baseUrlMode=explicit"
PAPERCLIP_PUBLIC_URL=https://dev.admin.talent.2flow.app
PAPERCLIP_AUTH_PUBLIC_BASE_URL=https://dev.admin.talent.2flow.app
PAPERCLIP_AUTH_BASE_URL_MODE=explicit
BETTER_AUTH_URL=https://dev.admin.talent.2flow.app

# Secreto de Better Auth (generar una sola vez, reutilizar en cada redeploy;
# regenerarlo invalida TODAS las sesiones activas)
# Generar con: openssl rand -base64 48
BETTER_AUTH_SECRET=<SECRET_MANAGER_BETTER_AUTH_SECRET>

# Clave de API de Paperclip (usada por App-Back y el plugin orchestrator-webhook)
PAPERCLIP_API_KEY=<SECRET_MANAGER_PAPERCLIP_API_KEY>

# Gemini (requerida para que los agentes — Lau, Mathew — funcionen)
GEMINI_API_KEY=<SECRET_MANAGER_GEMINI_API_KEY>
GEMINI_CLI_TRUST_WORKSPACE=true

# Instancia de Paperclip (defaults del Dockerfile, explícitos por claridad)
PAPERCLIP_INSTANCE_ID=default
PAPERCLIP_CONFIG=/paperclip/instances/default/config.json
OPENCODE_ALLOW_ALL_MODELS=true

# UI servida por el propio Paperclip (el Dockerfile ya lo trae, explícito por claridad)
SERVE_UI=true